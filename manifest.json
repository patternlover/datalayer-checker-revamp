{
   "action": {
      "default_icon": {
         "128": "images/icon128.png",
         "16": "images/icon16.png",
         "32": "images/icon32.png",
         "48": "images/icon48.png"
      },
      "default_title": "DataLayer Checker Plus"
   },
   "side_panel": {
      "default_path": "index.html"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "description": "The simplest way to debug and verify dataLayer implementations without using the browser console",
   "host_permissions": [ "https://*/*" ],
   "icons": {
      "128": "images/icon128.png",
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png"
   },
   "manifest_version": 3,
   "minimum_chrome_version": "116",
   "name": "DataLayer Checker Plus",
   "permissions": [ "scripting", "webNavigation", "webRequest", "storage", "clipboardWrite", "sidePanel" ],
   "version": "1.5.0",
   "web_accessible_resources": [ {
      "matches": [ "https://*/*" ],
      "resources": [ "scripts/vendor.js" ]
   } ]
}
